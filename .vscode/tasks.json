{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C/C++: g++ build active file",
      "command": "/usr/bin/g++",
      "args": [
        "-std=c++11",
        "${workspaceFolder}/src/main.cpp",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}",
        "-I",
        "/opt/homebrew/include",
        "-L",
        "/opt/homebrew/lib",
        "-lassimp",
        "-lglfw",
        "-lGLEW",
        "-framework",
        "OpenGL",

      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Task generated by Debugger."
    }
  ],
  "version": "2.0.0"
}